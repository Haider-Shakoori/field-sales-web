APP_NAME="FieldPulse"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://fieldpulse.businessos.af
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=field_sales
DB_USERNAME=field_sales
DB_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

FIELD_SALES_MAX_BATCH_POINTS=100

FIELD_SALES_BACKUP_DIR=/var/backups/field-sales
FIELD_SALES_BACKUP_RETENTION_DAYS=14
FIELD_SALES_REQUIRE_SCHEDULER_HEARTBEAT=false
FIELD_SALES_SCHEDULER_HEARTBEAT_MAX_AGE_SECONDS=180
FIELD_SALES_SCHEDULE_BACKUPS=false
FIELD_SALES_MONITOR_MAX_FAILED_JOBS=10
FIELD_SALES_MONITOR_MAX_QUEUED_JOBS=1000
FIELD_SALES_MONITOR_MAX_OLDEST_JOB_SECONDS=600

PUSH_NOTIFICATIONS_ENABLED=false
PUSH_NOTIFICATIONS_ENDPOINT=
PUSH_NOTIFICATIONS_BEARER_TOKEN=
PUSH_NOTIFICATIONS_TIMEOUT=10

AI_TRANSCRIPTION_ENABLED=false
AI_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
AI_TRANSCRIPTION_TIMEOUT=45

BUSINESSOS_INTEGRATION_ENABLED=false
BUSINESSOS_INTEGRATION_BASE_URL=
BUSINESSOS_INTEGRATION_TOKEN=
BUSINESSOS_INTEGRATION_TIMEOUT=20
BUSINESSOS_INTEGRATION_PUSH_BATCH_SIZE=200
BUSINESSOS_INTEGRATION_HEALTH_PATH=/api/fieldpulse/v1/health
BUSINESSOS_INTEGRATION_MASTER_DATA_PATH=/api/fieldpulse/v1/master-data
BUSINESSOS_INTEGRATION_EVENTS_PATH=/api/fieldpulse/v1/events
