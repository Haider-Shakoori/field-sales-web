APP_NAME="Field Sales"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://field-sales.example.com
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=field_sales
DB_USERNAME=field_sales
DB_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

FIELD_SALES_MAX_BATCH_POINTS=100

PUSH_NOTIFICATIONS_ENABLED=false
PUSH_NOTIFICATIONS_ENDPOINT=
PUSH_NOTIFICATIONS_BEARER_TOKEN=
PUSH_NOTIFICATIONS_TIMEOUT=10
