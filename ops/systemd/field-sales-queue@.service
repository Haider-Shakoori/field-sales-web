[Unit]
Description=Field Sales Laravel queue worker %i
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/field-sales/current
ExecStart=/usr/bin/php /var/www/field-sales/current/artisan queue:work database --queue=default --sleep=3 --tries=3 --timeout=60 --max-time=3600 --no-interaction
ExecReload=/usr/bin/php /var/www/field-sales/current/artisan queue:restart
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=3600
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
