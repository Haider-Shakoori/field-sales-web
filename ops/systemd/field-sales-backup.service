[Unit]
Description=Field Sales database and media backup
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/field-sales/current
ExecStart=/usr/bin/php /var/www/field-sales/current/artisan field-sales:backup --label=scheduled
Nice=10
PrivateTmp=true
ProtectHome=true
